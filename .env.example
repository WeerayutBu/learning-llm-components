# Shared across the whole project. Copy to .env (gitignored) and fill in.
# Modules load it via `load_dotenv(find_dotenv())`, which walks up to this root file.
# Left blank on purpose: a realistic-looking placeholder reads as "already filled in"
# and fails later as a confusing 401. Get a key: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# DiZiNER (agent module): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Used as supervisor when config.json sets supervisor to "env".
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_REASONING_EFFORT=low
